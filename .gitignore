# Rust build artifacts
target/

# Prebuilt binary used to build the container image
dist/

# Local log file
vsm.log

# Coverage reports
coverage/

# Secrets / local environment
.env

# Cert/Key files
*.crt
*.key

# Terraform related files
.terraform/
.terraform.lock.hcl
# We don't need the state files since we rebuild in memory every new containers
*.tfstate

# Skip node modules
node_modules

# Cypress stuff
**/cypress/screenshots
**/cypress/downloads

.worktrees/
